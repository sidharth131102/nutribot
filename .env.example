# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development   # development | staging | production -- prod refuses to boot with insecure/missing secrets below

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=azure_openai   # groq | azure_openai -- Groq kept configured as a fallback option

# Groq
GROQ_API_KEY=gsk_...
LLM_MODEL=openai/gpt-oss-120b
LLM_MODEL_FAST=openai/gpt-oss-20b

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_FULL=gpt-5-mini
AZURE_OPENAI_DEPLOYMENT_FAST=gpt-5-mini   # same deployment as full by default -- see docs/CURRENT_STATE.md for why (gpt-5-nano hit a subscription quota wall on a fresh trial)
AZURE_OPENAI_REASONING_MODEL=true         # gpt-5 family = reasoning model (reasoning_effort, no temperature); set false when promoting a classic chat model like gpt-4.1

# Azure OpenAI challenger (Phase 7) -- a second deployment on the SAME resource, eval-only until promoted.
# Compare with: python -m backend.eval.runner --compare
AZURE_OPENAI_CHALLENGER_DEPLOYMENT_FULL=gpt-4.1-1   # Azure's default deployment name for gpt-4.1 -- dots are allowed
AZURE_OPENAI_CHALLENGER_DEPLOYMENT_FAST=gpt-4.1-1
AZURE_OPENAI_CHALLENGER_REASONING_MODEL=false

# Eval -- the provider the DeepEval judge is pinned to. Deliberately NOT LLM_PROVIDER:
# in --compare mode the challenger arm would otherwise judge its own output.
EVAL_JUDGE_PROVIDER=azure_openai

# ── Azure Blob Storage (medical document uploads, Phase 4) ───────────────────
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=medical-documents

# ── Azure Document Intelligence (medical document OCR, Phase 4) ──────────────
AZURE_DOC_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DOC_INTELLIGENCE_API_KEY=

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=nutribot

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRE_MINUTES=10080          # 7 days

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (SendGrid) ─────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxx
EMAIL_FROM=noreply@nutribot.ai
EMAIL_FROM_NAME=NutriBot

# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=nutribot-knowledge

# ── LangSmith tracing (Phase 6, opt-in) ───────────────────────────────────────
LANGSMITH_TRACING_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nutribot

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Voice input (STT) + multilingual chat ─────────────────────────────────────
# One "Azure AI services" multi-service resource covers both Speech and
# Translator with a single key/region. Leave the translator fields empty to
# reuse the speech key/region. Empty AZURE_SPEECH_KEY = mic button hidden.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
# Candidate spoken languages for auto-detection (BCP-47, max 4, one locale per language)
SPEECH_RECOGNITION_LANGUAGES=en-IN,hi-IN,ml-IN,fr-FR
# Translate-at-the-edges: messages in any language -> English pipeline -> reply in that language
MULTILINGUAL_ENABLED=true
