# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development   # development | staging | production -- prod refuses to boot with insecure/missing secrets below

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=azure_openai   # groq | azure_openai -- Groq kept configured as a fallback option

# Groq
GROQ_API_KEY=gsk_...
LLM_MODEL=openai/gpt-oss-120b
LLM_MODEL_FAST=openai/gpt-oss-20b

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_FULL=gpt-5-mini
AZURE_OPENAI_DEPLOYMENT_FAST=gpt-5-mini   # same deployment as full by default -- see docs/CURRENT_STATE.md for why (gpt-5-nano hit a subscription quota wall on a fresh trial)

# ── Azure Blob Storage (medical document uploads, Phase 4) ───────────────────
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=medical-documents

# ── Azure Document Intelligence (medical document OCR, Phase 4) ──────────────
AZURE_DOC_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DOC_INTELLIGENCE_API_KEY=

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=nutribot

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRE_MINUTES=10080          # 7 days

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (SendGrid) ─────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxx
EMAIL_FROM=noreply@nutribot.ai
EMAIL_FROM_NAME=NutriBot

# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=nutribot-knowledge

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
